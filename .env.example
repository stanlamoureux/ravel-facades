# Copie ce fichier en .env.local pour le dev local.
# Sur Vercel, ces variables sont déjà configurées dans le projet.

# Supabase : table des demandes de devis (insert seul, via RLS)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxx
